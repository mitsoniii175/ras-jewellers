# Copy the NAMES of these into Netlify > Site settings > Environment variables.
# Never commit real values, and never put them in the repo.

# --- Admin bootstrap (required once, then DELETE both) ---------------------
# Creates the first owner account on first login at /admin.
# Only ever fires when zero admins exist. Password must be 12+ characters.
ADMIN_BOOTSTRAP_EMAIL=owner@rasjewellers.com
ADMIN_BOOTSTRAP_PASSWORD=

# --- Razorpay (optional; online payment is disabled without these) ---------
# Start with TEST keys (rzp_test_...). Switch to live only after verifying.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (optional; shipment creation + live tracking) --------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Haldharvas
SHIPROCKET_WEBHOOK_TOKEN=

# --- Customer notifications (optional; nothing is sent without these) ------
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=

# --- Testing helpers (leave unset in production) ---------------------------
# RAS_SHOW_RESET_LINK=1  returns password-reset links in the API response.
#                        NEVER enable in production.
